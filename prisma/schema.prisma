generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  // Optional for WebAuthn support
  Authenticator Authenticator[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Edge {
  id           String   @id @default(uuid())
  sourceNodeId String
  targetNodeId String
  workflowId   String
  workflow     Workflow @relation(fields: [workflowId], references: [id])
  data         Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations to Node model
  sourceNode Node @relation("SourceEdge", fields: [sourceNodeId], references: [id])
  targetNode Node @relation("TargetEdge", fields: [targetNodeId], references: [id])
}

model Node {
  id         String    @id @default(uuid())
  type       String
  workflowId String
  workflow   Workflow  @relation(fields: [workflowId], references: [id])
  positionX  Float
  positionY  Float
  data       NodeData?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Reverse relations (no fields or references)
  sourceEdges Edge[] @relation("SourceEdge")
  targetEdges Edge[] @relation("TargetEdge")
}

model Workflow {
  id          String   @id @default(uuid())
  name        String
  description String?
  nodes       Node[]
  edges       Edge[]
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NodeData {
  id          String   @id @default(uuid())
  nodeId      String   @unique
  node        Node     @relation(fields: [nodeId], references: [id])
  title       String
  description String
  prompt      String?
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
